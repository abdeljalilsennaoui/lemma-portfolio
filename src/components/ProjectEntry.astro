---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import ProjectVisual from './ProjectVisual.astro';
import type { Locale } from '../i18n';
import { ui } from '../i18n/ui';
import type { Project } from '../types/content';
import { href } from '../utils/paths';

/**
 * One project in the gallery, worked the way a problem is on the pad: its
 * number and context in the margin, the statement, the figures, and the
 * answer in a box at the end.
 */
interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const strings = ui.work;
const caseStudy = href(`/work/${project.slug}/`, locale);
const headingId = `work-${project.slug}`;
// Month names take a capital in English but not in French.
const period = locale === 'fr' ? project.period.fr.toLowerCase() : project.period.en;

// Up to three further figures are shown small under the main one; the rest
// are counted, and all of them are in the case study.
const gallery = project.gallery ?? [];
const thumbs = gallery.slice(0, 3);
const remaining = gallery.length - thumbs.length;
// The cover is Figure 1 of the case study, so the gallery starts at 2.
const firstThumbFigure = 2;
---

<article class="sheet entry" aria-labelledby={headingId}>
  <div class="margin-note">
    <div class="margin-stick">
      <p class="margin-key">{strings.lemma[locale]}&nbsp;{project.order}</p>
      <p class="entry-context">{project.context.label[locale]}</p>
      <p>{period}</p>
    </div>
  </div>

  <div class="sheet-body">
    <div class="statement">
      <h3 id={headingId}><a href={caseStudy}>{project.title}</a>.</h3>{' '}
      <p class="theorem-body">{project.summary[locale]}</p>
    </div>

    <!-- Clicking the picture opens the case study too. It is a pointer
         convenience only: the title and the button are the real links. -->
    <figure class="entry-visual" data-open={caseStudy}>
      <ProjectVisual project={project} locale={locale} />
      <figcaption class="caption">
        <span class="caption-label">{strings.figure[locale]}&nbsp;1.</span>{' '}
        {project.cover ? project.cover.caption[locale] : project.architecture.diagram.caption[locale]}
      </figcaption>
    </figure>

    {
      thumbs.length > 0 && (
        <ul class="thumbs">
          {thumbs.map((figure, index) => (
            <li>
              <a class="thumb frame" href={`${caseStudy}#gallery`} title={figure.caption[locale]}>
                <Image
                  src={figure.src}
                  alt=""
                  widths={[240, 480]}
                  sizes="(min-width: 40rem) 14rem, 30vw"
                  loading="lazy"
                />
                <span class="sr-only">
                  {strings.figure[locale]} {firstThumbFigure + index}, {project.title}: {figure.caption[locale]}
                </span>
              </a>
            </li>
          ))}
          <li class="thumbs-more">
            <a class="link" href={`${caseStudy}#gallery`}>
              {remaining > 0
                ? strings.moreFigures[locale].replace('{n}', String(remaining))
                : strings.allFigures[locale]}
              <span class="sr-only">: {project.title}</span>
            </a>
          </li>
        </ul>
      )
    }

    <dl class="entry-facts">
      <div>
        <dt>{strings.result[locale]}</dt>
        <dd>
          <span class="answer">
            <span class="hl">{project.proof.figure[locale]}</span>{' '}
            {project.proof.claim[locale]}
          </span>
        </dd>
      </div>
      <div>
        <dt>{strings.builtWith[locale]}</dt>
        <dd>{project.stack.join(', ')}</dd>
      </div>
    </dl>

    <p class="entry-links">
      <a class="button button-primary" href={caseStudy}>
        {strings.caseStudy[locale]}<span class="sr-only">: {project.title}</span>
      </a>
      <a class="link entry-repo" href={project.repository.url} target="_blank" rel="noopener">
        <Icon name="github" size={16} />
        {strings.repository[locale]}<span class="sr-only">: {project.title} ({strings.opensInNewTab[locale]})</span>
        <Icon name="external" size={14} />
      </a>
    </p>
  </div>
</article>

<script>
  for (const visual of document.querySelectorAll<HTMLElement>('[data-open]')) {
    visual.addEventListener('click', () => {
      if (visual.dataset.open) window.location.href = visual.dataset.open;
    });
  }
</script>

<style>
  /* Entries follow one another down the same sheet, parted by a light rule
     in the body. */
  .entry + .entry > .sheet-body {
    background: linear-gradient(var(--line-strong), var(--line-strong)) right top / calc(100% - 2.5rem) 1px no-repeat;
  }

  .entry-context {
    margin-top: 0.5rem;
  }

  /* Name and claim run on as one paragraph, as in a paper: a bold run-in
     head, then the statement in italics. */
  .statement {
    max-width: 46rem;
    font-size: clamp(1.4375rem, 2.5vw, 1.75rem);
    line-height: 1.3;
  }

  .statement h3,
  .statement p {
    display: inline;
  }

  .statement h3 {
    font-weight: 700;
  }

  .statement h3 a {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    transition: text-decoration-color 150ms ease;
  }

  .statement h3 a:hover {
    text-decoration-color: var(--mark);
    text-decoration-thickness: 2px;
  }

  .entry-visual {
    margin-top: 1.75rem;
    min-width: 0;
  }

  :global(.js) .entry-visual {
    cursor: pointer;
  }

  .entry-visual :global(.plate) {
    transition:
      border-color 200ms ease,
      box-shadow 200ms ease;
  }

  .entry-visual:hover :global(.plate) {
    border-color: var(--mark);
    box-shadow: 0 0 0 1px var(--mark);
  }

  /* Further figures, small. Four across: three pictures and the count. */
  .thumbs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.625rem;
    margin-top: 1.25rem;
    font-size: var(--text-sm);
  }

  .thumb {
    display: block;
    padding: 0.25rem;
    transition: border-color 150ms ease;
  }

  .thumb:hover {
    border-color: var(--mark);
  }

  .thumb :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: left top;
  }

  .thumbs-more {
    grid-column: 1 / -1;
  }

  .thumbs-more a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  .entry-facts {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.75rem;
    font-size: var(--text-sm);
  }

  .entry-facts dt {
    margin-bottom: 0.375rem;
    color: var(--muted);
  }

  .answer {
    font-size: var(--text-base);
  }

  .entry-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.75rem;
    margin-top: 1.75rem;
    font-size: var(--text-sm);
  }

  .entry-repo {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    min-height: 2.75rem;
  }

  @media (min-width: 40rem) {
    .thumbs {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .thumbs-more {
      grid-column: auto;
      align-self: center;
      padding-left: 0.5rem;
    }

    .entry-facts {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 2.5rem;
      align-items: start;
    }
  }

  @media (max-width: 63.99rem) {
    .entry + .entry > .sheet-body {
      background: none;
    }

    .entry + .entry {
      border-top: 1px solid var(--line-strong);
    }

    .entry .margin-stick {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0 1rem;
    }

    .entry-context {
      margin-top: 0;
    }
  }
</style>
