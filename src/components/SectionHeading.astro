---
/**
 * A numbered section title, set like `\section` in a typeset article, with
 * an optional one-sentence introduction beside it.
 */
interface Props {
  id: string;
  number: number;
  title: string;
  intro?: string;
}

const { id, number, title, intro } = Astro.props;
---

<div class="heading">
  <h2 id={id}><span class="heading-number">{number}</span>{' '}{title}</h2>
  {intro && <p>{intro}</p>}
</div>

<style>
  .heading {
    display: grid;
    gap: 0.75rem;
    padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
    border-bottom: 2px solid var(--text);
  }

  h2 {
    font-family: var(--font-serif);
    font-size: clamp(2.125rem, 5vw, 3.125rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  .heading-number {
    margin-right: 0.3em;
  }

  p {
    max-width: 34rem;
    color: var(--muted);
  }

  @media (min-width: 64rem) {
    .heading {
      grid-template-columns: 5fr 7fr;
      gap: 4rem;
      align-items: end;
    }
  }
</style>
