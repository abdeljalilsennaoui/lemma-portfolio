---
import Icon from './Icon.astro';
import Relation from './Relation.astro';
import { brand, links } from '../config/site';
import type { Locale } from '../i18n';
import { ui } from '../i18n/ui';
import { href } from '../utils/paths';

/**
 * The hero is typeset as what the brand is named after: a lemma, its
 * statement, and a proof that ends in the tombstone.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = ui.hero;
---

<section class="hero board" aria-labelledby="hero-title">
  <div class="shell">
    <p class="hero-label theorem-label">
      {strings.lemma[locale]}.<sup class="hero-mark" aria-hidden="true">1</sup>
    </p>
    <h1 id="hero-title" class="hero-title">{brand.headline[locale]}</h1>

    <div class="hero-grid">
      <div class="hero-proof">
        <p class="hero-body">
          <span class="theorem-body">{strings.proof[locale]}.</span>
          {strings.proofBody[locale]}
          <span class="hero-qed">
            <span class="tombstone" aria-hidden="true"></span><span class="sr-only">{strings.endOfProof[locale]}</span>
          </span>
        </p>
        <p class="hero-actions">
          <a class="button button-primary" href={href('/#work', locale)}>{strings.explore[locale]}</a>
          <a class="button" href={links.github} rel="me noopener">
            <Icon name="github" />
            {strings.github[locale]}
          </a>
        </p>
        <p id="lemma-note" class="hero-note">
          <sup aria-hidden="true">1</sup>
          <span class="sr-only">{strings.footnoteLabel[locale]}: </span>{strings.footnote[locale]}
        </p>
      </div>

      <div class="hero-visual">
        <Relation locale={locale} />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(2rem, 6vw, 4.5rem);
    padding-bottom: clamp(3.5rem, 8vw, 6.5rem);
  }

  .hero-label {
    font-size: clamp(1.375rem, 2.6vw, 2rem);
    line-height: 1;
  }

  .hero-mark {
    margin-left: 0.1em;
    font-size: 0.55em;
    font-weight: 400;
    color: var(--muted);
  }

  .hero-title {
    margin-top: 0.25rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(3.5rem, 13.2vw, 11rem);
    line-height: 0.95;
    letter-spacing: -0.025em;
    /* Pull the slanted first letter back onto the left edge. */
    margin-left: -0.03em;
  }

  .hero-grid {
    display: grid;
    gap: 3.5rem;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .hero-grid > * {
    min-width: 0;
  }

  .hero-body {
    max-width: 31rem;
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--text);
  }

  .hero-body .theorem-body {
    font-size: 1.12em;
    margin-right: 0.25em;
  }

  /* As in a typeset proof, the mark sits at the end of the last line. */
  .hero-qed {
    float: right;
    margin-top: 0.45em;
    margin-left: 0.75rem;
    line-height: 1;
  }

  .hero-qed .tombstone {
    width: 0.7em;
    height: 0.7em;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.5rem;
    clear: both;
  }

  /* A footnote, the way a paper sets one: a short rule, then small type. */
  .hero-note {
    max-width: 26rem;
    margin-top: 3rem;
    padding-top: 0.75rem;
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--muted);
    background: linear-gradient(var(--line-strong), var(--line-strong)) top left / 6rem 1px no-repeat;
  }

  .hero-note sup {
    margin-right: 0.2em;
  }

  @media (min-width: 64rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 5rem;
      align-items: start;
    }
  }

  /* The statement arrives, then the matrix fills in (see Relation.astro). */
  @media (prefers-reduced-motion: no-preference) {
    .hero-label,
    .hero-title,
    .hero-proof {
      animation: settle 800ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    .hero-title {
      animation-delay: 70ms;
    }

    .hero-proof {
      animation-delay: 180ms;
    }

    @keyframes settle {
      from {
        opacity: 0;
        transform: translateY(0.75rem);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>
