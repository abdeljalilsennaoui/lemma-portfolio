---
import Atlas from './atlas/Atlas.astro';
import Icon from './Icon.astro';
import { brand, links, person } from '../config/site';
import type { Locale } from '../i18n';
import { ui } from '../i18n/ui';
import { href } from '../utils/paths';

/**
 * The top of the sheet. First the pad's title block, which answers who this
 * is before anything else. Then a lemma and its proof, the form the site is
 * named after: the claim is the headline, and the proof is a construction,
 * the figure of the whole site with one result per project (`Atlas.astro`).
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = ui.hero;
const block = ui.titleBlock;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="shell">
    <dl class="title-block" aria-label={block.label[locale]}>
      <div>
        <dt>{block.name[locale]}</dt>
        <dd>{person.name}</dd>
      </div>
      <div>
        <dt>{block.program[locale]}</dt>
        <dd>
          <a class="program" href={person.school.programUrl} rel="noopener">
            {block.programValue[locale]}, {person.school.name[locale]}
            <Icon name="external" size={13} />
          </a>
        </dd>
      </div>
      <div>
        <dt>{block.basedIn[locale]}</dt>
        <dd>{block.basedInValue[locale]}</dd>
      </div>
      <div>
        <dt>{block.openTo[locale]}</dt>
        <dd>{block.openToValue[locale]}</dd>
      </div>
    </dl>

    <div class="sheet">
      <p class="margin-note claim-label">
        <span class="margin-key">{strings.lemma[locale]}.</span>
      </p>
      <div class="sheet-body claim-body">
        <h1 id="hero-title" class="hero-title">{brand.headline[locale]}</h1>
      </div>
    </div>

    <div class="sheet">
      <p class="margin-note proof-label">
        <span class="margin-key">{strings.proof[locale]}.</span>
      </p>
      <div class="sheet-body proof-body">
        <p class="hero-body">{strings.proofBody[locale]}</p>

      </div>
    </div>

    <div class="hero-figure">
      <Atlas locale={locale} />
    </div>

    <div class="sheet">
      <div class="margin-note closing-label"></div>
      <div class="sheet-body closing-body">
        <p class="hero-qed">
          <span class="tombstone" aria-hidden="true"></span><span class="sr-only">{strings.endOfProof[locale]}</span>
        </p>

        <p class="hero-actions">
          <a class="button button-primary" href={href('/#work', locale)}>{strings.explore[locale]}</a>
          {
            links.email && (
              <a class="button" href={`mailto:${links.email}`}>
                <Icon name="mail" />
                {strings.email[locale]}
              </a>
            )
          }
        </p>

        <p class="hero-note">
          <span class="sr-only">{strings.footnoteLabel[locale]}: </span>{strings.footnote[locale]}
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(1.25rem, 3vw, 2rem);
  }

  /* The ruled header of an engineering pad: name, course, place, and here
     what the reader most needs to know. The first cell is as wide as the
     margin, so its edge lines up with the rule that runs down the page. */
  .title-block {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1.5px solid var(--text);
    background: var(--panel);
    font-size: var(--text-sm);
    line-height: 1.35;
  }

  .title-block > div {
    padding: 0.625rem 0.875rem 0.75rem;
    border-top: 1px solid var(--line-strong);
    border-left: 1px solid var(--line-strong);
  }

  .title-block > div:nth-child(-n + 2) {
    border-top: 0;
  }

  .title-block > div:nth-child(odd) {
    border-left: 0;
  }

  .title-block dt {
    font-size: var(--text-2xs);
    color: var(--muted);
  }

  .title-block dd {
    margin-top: 0.125rem;
    font-weight: 700;
  }

  /* The program is a link to the university's page for the degree. */
  .program {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition: text-decoration-color 150ms ease;
  }

  .program:hover {
    text-decoration-color: var(--mark);
    text-decoration-thickness: 2px;
  }

  .program :global(svg) {
    display: inline;
    vertical-align: -0.05em;
    margin-left: 0.2em;
  }

  /* The claim and its proof read as one block, so the usual sheet padding is
     closed up between them. */
  .sheet > .claim-label,
  .sheet > .claim-body {
    padding-top: clamp(1.75rem, 3.6vw, 2.75rem);
    padding-bottom: 0;
  }

  .sheet > .proof-label,
  .sheet > .proof-body {
    padding-top: clamp(1.25rem, 2.4vw, 1.75rem);
  }

  .proof-label .margin-key {
    font-style: italic;
    font-weight: 400;
  }

  .hero-title {
    max-width: 11.5em;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: clamp(2.625rem, 5.8vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.022em;
  }

  .hero-body {
    max-width: 46rem;
    font-size: var(--text-lg);
    line-height: 1.5;
  }

  /* The proof is a figure, and it runs the full width of the sheet: the
     margin rule stops above it and picks up again below. */
  .sheet > .proof-label {
    padding-bottom: 0;
  }

  .sheet > .proof-body {
    padding-bottom: 1.25rem;
  }

  .hero-figure {
    min-width: 0;
  }

  .sheet > .closing-label {
    padding-top: 0;
  }

  .sheet > .closing-body {
    padding-top: 0.875rem;
  }

  /* As in a typeset proof, the mark sits at the end of the last line. */
  .hero-qed {
    display: flex;
    justify-content: flex-end;
    line-height: 1;
  }

  .hero-qed .tombstone {
    width: 0.8125rem;
    height: 0.8125rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .hero-note {
    max-width: 34rem;
    margin-top: 2.25rem;
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--muted);
  }

  @media (min-width: 64rem) {
    .title-block {
      grid-template-columns: var(--margin-col) 1.5fr 1fr 1fr;
    }

    .title-block > div,
    .title-block > div:nth-child(odd) {
      border-top: 0;
      border-left: 1px solid var(--line-strong);
    }

    .title-block > div:first-child {
      border-left: 0;
    }

    .sheet > .proof-label {
      /* Sits on the first line of the proof, not above it. */
      padding-top: calc(clamp(1.25rem, 2.4vw, 1.75rem) + 0.1rem);
    }
  }
</style>
