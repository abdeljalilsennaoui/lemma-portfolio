---
import AtlasPanels from './AtlasPanels.astro';
import { brand } from '../../config/site';
import { disciplines } from '../../data/disciplines';
import { projects } from '../../data/projects';
import { disciplineNodeId, lemmaId, relation } from '../../data/system';
import type { Locale } from '../../i18n';
import { ui } from '../../i18n/ui';
import { href } from '../../utils/paths';

/**
 * The proof on the home page, drawn as one figure of the whole site.
 *
 * The markup is a list of results and the matrix of the relation R ⊆ P × D
 * between projects and disciplines. That is what a small screen, a reader
 * without JavaScript and a search engine get, and it is complete.
 *
 * On a wide screen `src/lib/atlas.ts` stands the same elements up as an
 * axonometric drawing: the ground is the product P × D with a filled square
 * for each pair of R, each project stands over its column, and the parts of
 * the site sit above them in the order a paper would give them. Seen from
 * directly above, the drawing is the matrix again.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = ui.atlas;

const context = (kind: 'solo' | 'team', size?: number) =>
  kind === 'team' && size ? strings.team[locale].replace('{n}', String(size)) : strings.solo[locale];

// Parts of the site that are not projects, in the order of a paper.
const parts = [
  { id: 'definition', kind: strings.kinds.definition[locale], name: ui.nav.about[locale], target: '/#about' },
  { id: 'axioms', kind: strings.kinds.axioms[locale], name: ui.engineering.principles[locale], target: '/#engineering' },
  { id: 'root', kind: '', name: brand.name, target: '/#about' },
  { id: 'corollary', kind: strings.kinds.corollary[locale], name: ui.nav.contact[locale], target: '/#contact' },
  { id: 'remark', kind: strings.kinds.remark[locale], name: ui.nav.community[locale], target: '/#community' },
];

// What the drawing needs to know about the relation.
const model = {
  lemmas: projects.map((project) => ({ id: lemmaId(project), disciplines: project.disciplines })),
  disciplines: disciplines.map((discipline) => discipline.id),
};
---

<figure class="atlas" data-atlas aria-label={strings.title[locale]}>
  <div class="atlas-bar">
    <p class="atlas-notation" aria-hidden="true">
      <i>R</i> ⊆ <i>P</i> × <i>D</i>, <span class="atlas-count">|<i>R</i>| = {relation.length}</span>
    </p>
    <div class="atlas-switch" role="group" aria-label={strings.viewLabel[locale]} data-switch hidden>
      <button type="button" data-view="axo" aria-pressed="true">{strings.axonometric[locale]}</button>
      <button type="button" data-view="plan" aria-pressed="false">{strings.plan[locale]}</button>
    </div>
  </div>

  <div class="atlas-stage" data-stage>
    <svg class="atlas-ink" data-ink aria-hidden="true" focusable="false"></svg>

    <ul class="atlas-parts" aria-label={strings.sections[locale]}>
      {
        parts.map((part) => (
          <li>
            <a
              class:list={['atlas-node', part.id === 'root' ? 'atlas-root' : 'atlas-part', `atlas-${part.id}`]}
              href={href(part.target, locale)}
              data-node={part.id}
              data-level="top"
            >
              {part.id === 'root' ? (
                <>
                  <span class="atlas-wordmark" aria-hidden="true">
                    {brand.wordmark}
                    <span class="tombstone" />
                  </span>
                  <span class="atlas-signature" aria-hidden="true">
                    {brand.signature}
                  </span>
                  <span class="sr-only">
                    {brand.name}: {strings.wholeSystem[locale]}
                  </span>
                </>
              ) : (
                <>
                  <span class="atlas-kind">{part.kind}</span>
                  <span class="sr-only">: </span>
                  <span class="atlas-name">{part.name}</span>
                </>
              )}
            </a>
          </li>
        ))
      }
    </ul>

    <ol class="atlas-lemmas" aria-label={ui.hero.ledgerTitle[locale]}>
      {
        projects.map((project, index) => (
          <li id={lemmaId(project)}>
            <a
              class="atlas-node atlas-lemma"
              href={href(`/work/${project.slug}/`, locale)}
              data-node={lemmaId(project)}
              data-level="lemma"
            >
              <span class="atlas-lemma-head">
                <span class="atlas-id" aria-hidden="true">
                  {lemmaId(project)}
                </span>
                <span class="atlas-name">{project.shortTitle}</span>
                <span class="atlas-context">{context(project.context.kind, project.context.teamSize)}</span>
              </span>
              <span class="atlas-leader" aria-hidden="true" />
              <span class="atlas-result">
                <span class="hl" style={`--i:${index}`}>
                  {project.proof.figure[locale]}
                </span>{' '}
                {project.proof.claim[locale]}
              </span>
            </a>
          </li>
        ))
      }
    </ol>

    <ul class="atlas-disciplines" aria-label={strings.disciplines[locale]}>
      {
        disciplines.map((discipline) => (
          <li>
            <button
              type="button"
              class="atlas-node atlas-discipline"
              data-node={disciplineNodeId(discipline.id)}
              data-level="ground"
            >
              {discipline.label[locale]}
            </button>
          </li>
        ))
      }
    </ul>

    <div class="atlas-matrix" data-matrix>
      <table>
        <caption class="sr-only">{strings.matrixTitle[locale]}</caption>
        <thead>
          <tr>
            <td></td>
            {
              disciplines.map((discipline) => (
                <th scope="col" data-col={discipline.id}>
                  <span>{discipline.label[locale]}</span>
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            projects.map((project) => (
              <tr data-row={project.slug} data-lemma={lemmaId(project)}>
                <th scope="row">
                  <a href={href(`/work/${project.slug}/`, locale)}>
                    <span class="atlas-id">{lemmaId(project)}</span>
                    <span class="atlas-name">{project.shortTitle}</span>
                  </a>
                </th>
                {disciplines.map((discipline) => {
                  const on = project.disciplines.includes(discipline.id);
                  return (
                    <td data-col={discipline.id}>
                      <span class="atlas-cell" data-on={on ? '' : undefined} />
                      <span class="sr-only">{on ? strings.yes[locale] : strings.no[locale]}</span>
                    </td>
                  );
                })}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="atlas-tap-hint">{strings.tapHint[locale]}</p>

    <aside class="atlas-sheet" data-sheet aria-label={strings.selected[locale]} hidden>
      <button type="button" class="atlas-dock-close" data-sheet-close aria-label={strings.close[locale]}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </button>
      <div class="atlas-dock-body" data-sheet-body></div>
    </aside>

    <aside class="atlas-dock" id="atlas-dock" data-dock aria-label={strings.selected[locale]} hidden>
      <button type="button" class="atlas-dock-close" data-dock-close aria-label={strings.close[locale]}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </button>
      <div class="atlas-dock-body" data-dock-body></div>
    </aside>
  </div>

  <figcaption>
    <span class="atlas-caption-matrix">{strings.matrixCaption[locale]}</span>
    <span class="atlas-caption-scene">{strings.caption[locale]} {strings.keys[locale]}</span>
  </figcaption>

  <AtlasPanels locale={locale} />
  <script type="application/json" data-model is:inline set:html={JSON.stringify(model)} />
</figure>

<script>
  import { mountAtlas } from '../../lib/atlas';

  const root = document.querySelector<HTMLElement>('[data-atlas]');
  if (root) mountAtlas(root);
</script>

<style is:global>
  /* The figure is styled globally because the drawing adds its own SVG
     elements, and the panel beside it is filled from templates. Every rule
     is kept under `.atlas`. */
  .atlas {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  .atlas-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 1rem;
  }

  .atlas-notation {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    white-space: nowrap;
  }

  .atlas-count {
    margin-left: 0.25rem;
  }

  /* Two text tabs; the current one is underlined. */
  .atlas-switch {
    display: inline-flex;
    gap: 1.25rem;
  }

  .atlas-switch[hidden] {
    display: none;
  }

  .atlas-switch button {
    min-height: 2.75rem;
    font-size: var(--text-sm);
    color: var(--muted);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
    transition:
      color 150ms ease,
      text-decoration-color 150ms ease;
  }

  .atlas-switch button:hover {
    color: var(--text);
  }

  .atlas-switch button[aria-pressed='true'] {
    color: var(--text);
    text-decoration-color: var(--mark);
  }

  .atlas figcaption {
    max-width: 44rem;
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--muted);
  }

  .atlas-caption-scene {
    display: none;
  }

  .atlas-id {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--muted);
  }

  /* ----- Without the drawing: a list of results, then the matrix -----

     These rules are the whole figure on a small screen and for a reader
     without JavaScript. The drawing below replaces them. */
  .atlas:not([data-scene]) .atlas-ink,
  .atlas:not([data-scene]) .atlas-parts,
  .atlas:not([data-scene]) .atlas-disciplines,
  .atlas:not([data-scene]) .atlas-context,
  .atlas:not([data-scene]) .atlas-dock {
    display: none;
  }

  .atlas:not([data-scene]) .atlas-stage {
    display: grid;
    gap: 1.75rem;
  }

  .atlas:not([data-scene]) .atlas-lemmas {
    border-top: 2px solid var(--text);
    border-bottom: 2px solid var(--text);
    background: var(--panel);
  }

  .atlas:not([data-scene]) .atlas-lemmas li + li {
    border-top: 1px solid var(--line);
  }

  .atlas:not([data-scene]) .atlas-lemma {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.125rem;
    padding: 0.875rem;
    line-height: 1.35;
  }

  .atlas:not([data-scene]) .atlas-lemma-head {
    display: flex;
    gap: 0.5rem;
  }

  .atlas:not([data-scene]) .atlas-lemma .atlas-id {
    flex: none;
    width: 1.75rem;
  }

  .atlas:not([data-scene]) .atlas-lemma .atlas-name {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.22em;
    transition: text-decoration-color 150ms ease;
  }

  .atlas:not([data-scene]) .atlas-lemma:hover .atlas-name {
    text-decoration-color: var(--mark);
  }

  .atlas:not([data-scene]) .atlas-leader {
    display: none;
  }

  .atlas:not([data-scene]) .atlas-result {
    padding-left: 2.25rem;
    color: var(--muted);
  }

  @media (min-width: 40rem) {
    .atlas:not([data-scene]) .atlas-lemma {
      grid-template-columns: auto minmax(1.5rem, 1fr) auto;
      align-items: baseline;
      gap: 0 0.5rem;
    }

    /* Dot leaders carry the eye from a project to its result. */
    .atlas:not([data-scene]) .atlas-leader {
      display: block;
      align-self: end;
      height: 0.35em;
      margin-bottom: 0.3em;
      background: radial-gradient(circle, var(--line-strong) 1px, transparent 1.25px) left bottom / 0.5rem 0.35em
        repeat-x;
    }

    .atlas:not([data-scene]) .atlas-result {
      max-width: 30rem;
      padding-left: 0;
      text-align: right;
    }
  }

  .atlas-matrix {
    max-width: 40rem;
  }

  /* Rows and column headings of the matrix can be chosen. */
  .js .atlas-matrix tbody tr,
  .js .atlas-matrix thead th {
    cursor: pointer;
  }

  .atlas-matrix thead th[aria-pressed='true'] span {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--mark);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  .atlas-tap-hint {
    margin-top: -1rem;
    font-size: var(--text-xs);
    color: var(--muted);
  }

  html:not(.js) .atlas-tap-hint,
  .atlas[data-scene] .atlas-tap-hint,
  .atlas[data-scene] .atlas-sheet {
    display: none;
  }

  /* What the chosen row or column holds, under the matrix. */
  .atlas-sheet {
    position: relative;
    border: 1.5px solid var(--text);
    background: var(--panel);
  }

  .atlas-sheet[hidden] {
    display: none;
  }

  .atlas-sheet .atlas-dock-body {
    overflow: visible;
  }

  .atlas-sheet .atlas-panel-actions {
    position: static;
    background: none;
  }

  .atlas[data-scene] .atlas-matrix {
    display: none;
  }

  .atlas-matrix table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    table-layout: fixed;
  }

  .atlas-matrix thead td {
    width: 7.75rem;
  }

  .atlas-matrix thead th {
    height: 8.75rem;
    padding: 0 0 0.75rem;
    vertical-align: bottom;
    font-size: var(--text-xs);
    font-weight: 400;
    line-height: 1.15;
    color: var(--muted);
    transition: color 150ms ease;
  }

  .atlas-matrix thead th span {
    display: inline-block;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    white-space: nowrap;
  }

  .atlas-matrix tbody th {
    padding: 0;
    font-size: var(--text-sm);
    font-weight: 400;
    text-align: left;
  }

  .atlas-matrix tbody th a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding-right: 0.5rem;
    line-height: 1.15;
  }

  .atlas-matrix tbody th a:hover .atlas-name {
    text-decoration: underline;
    text-decoration-color: var(--mark);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  .atlas-matrix tbody td {
    padding: 0.1875rem;
  }

  .atlas-cell {
    display: block;
    width: 100%;
    max-width: 3.5rem;
    aspect-ratio: 1;
    margin-inline: auto;
    border: 1px solid var(--line-strong);
    transition:
      background-color 150ms ease,
      border-color 150ms ease,
      opacity 150ms ease;
  }

  .atlas-cell[data-on] {
    border-color: var(--mark);
    background: var(--mark);
  }

  .atlas-matrix[data-active] td:not([data-lit]) .atlas-cell {
    opacity: 0.3;
  }

  .atlas-matrix[data-active] tr[data-lit] .atlas-cell {
    opacity: 1;
  }

  .atlas-matrix thead th[data-lit] {
    color: var(--text);
  }

  @media (min-width: 30rem) {
    .atlas-matrix thead td {
      width: 10rem;
    }

    .atlas-matrix tbody td {
      padding: 0.25rem;
    }
  }

  /* While the drawing is being set up on a wide screen its place is held,
     so the page does not jump. If the script never arrives, the list and the
     matrix appear after a moment instead. */
  @media (min-width: 64rem) {
    .js .atlas:not([data-scene]):not([data-flat]) .atlas-stage {
      min-height: var(--atlas-height);
      visibility: hidden;
      animation: atlas-fallback 0s 3s forwards;
    }
  }

  @keyframes atlas-fallback {
    to {
      visibility: visible;
    }
  }

  /* ----- The drawing ----- */
  .atlas {
    --atlas-height: clamp(36rem, calc(100vh - 8rem), 41rem);
    --dock-width: clamp(18rem, 30%, 22rem);
  }

  .atlas[data-scene] .atlas-caption-matrix {
    display: none;
  }

  .atlas[data-scene] .atlas-caption-scene {
    display: inline;
  }

  .atlas[data-scene] .atlas-stage {
    position: relative;
    height: var(--atlas-height);
    overflow: hidden;
    border: 1.5px solid var(--text);
    background: var(--panel);
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }

  .atlas[data-scene][data-dragging] .atlas-stage {
    cursor: grabbing;
  }

  .atlas[data-scene]:not([data-ready]) .atlas-stage > * {
    opacity: 0;
  }

  .atlas-ink {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    transition: opacity 400ms ease;
  }

  .atlas-ink * {
    vector-effect: non-scaling-stroke;
  }

  /* The ground: the product P × D, ruled into its cells. */
  .atlas-ground {
    fill: color-mix(in srgb, var(--mark) 4%, var(--bg));
    stroke: var(--line-strong);
    stroke-width: 1.25;
  }

  .atlas-rule {
    fill: none;
    stroke: var(--line);
    stroke-width: 1;
  }

  .atlas-product {
    fill: var(--line-strong);
    font-family: var(--font-serif);
    font-size: 30px;
    font-style: italic;
    text-anchor: end;
  }

  /* The ground is a slab: its two edges that face the reader. */
  .atlas-slab {
    fill: color-mix(in srgb, var(--line-strong) 38%, var(--bg));
    stroke: var(--line-strong);
    stroke-width: 1;
    stroke-linejoin: round;
  }

  .atlas-slab-side {
    fill: color-mix(in srgb, var(--line-strong) 58%, var(--bg));
  }

  /* A pair of the relation: the square that ends a proof, standing up as a
     block. Its sides are the same colour in shade. */
  .atlas-pair {
    transition: opacity 200ms ease;
  }

  .atlas-pair path {
    stroke-width: 0.75;
    stroke-linejoin: round;
  }

  .atlas-face-top {
    fill: var(--mark);
    stroke: var(--mark);
  }

  .atlas-face-front {
    fill: color-mix(in srgb, var(--mark) 68%, black);
    stroke: color-mix(in srgb, var(--mark) 68%, black);
  }

  .atlas-face-side {
    fill: color-mix(in srgb, var(--mark) 46%, black);
    stroke: color-mix(in srgb, var(--mark) 46%, black);
  }

  /* From a project down to each discipline it exercised. */
  .atlas-wire {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1;
    transition:
      stroke 200ms ease,
      opacity 200ms ease;
  }

  /* From a project up to the claim it supports, and from one part of the
     paper to the next. */
  .atlas-arrow {
    fill: none;
    stroke: var(--text);
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      stroke 200ms ease,
      opacity 200ms ease;
  }

  .atlas-aside {
    stroke-dasharray: 3 4;
  }

  .atlas-drop {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1;
    stroke-dasharray: 1 4;
    stroke-linecap: round;
  }

  .atlas[data-active] .atlas-pair:not([data-lit]),
  .atlas[data-active] .atlas-wire:not([data-lit]),
  .atlas[data-active] .atlas-arrow:not([data-lit]) {
    opacity: 0.16;
  }

  .atlas-wire[data-lit] {
    stroke: var(--mark);
    stroke-width: 1.5;
  }

  .atlas-arrow[data-lit] {
    stroke: var(--mark);
    stroke-width: 1.75;
  }

  .atlas[data-scene] :is(.atlas-parts, .atlas-lemmas, .atlas-disciplines),
  .atlas[data-scene] :is(.atlas-parts, .atlas-lemmas, .atlas-disciplines) > li {
    display: contents;
  }

  .atlas[data-scene] .atlas-node {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    color: var(--text);
    cursor: pointer;
    transform-origin: 0 0;
    will-change: transform;
    transition:
      opacity 200ms ease,
      border-color 150ms ease,
      background-color 150ms ease,
      box-shadow 150ms ease,
      color 150ms ease;
  }

  .atlas[data-active] .atlas-node:not([data-lit]) {
    opacity: 0.42;
  }

  /* A project: a class box, its name above the rule and what it proved
     below. */
  .atlas[data-scene] .atlas-lemma {
    z-index: 2;
    width: 9.5rem;
    border: 1.5px solid var(--text);
    background: var(--panel);
    box-shadow: 3px 3px 0 var(--line);
    font-size: var(--text-xs);
    line-height: 1.3;
  }

  .atlas[data-scene] .atlas-lemma-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0 0.375rem;
    align-items: baseline;
    padding: 0.4375rem 0.5625rem;
    border-bottom: 1px solid var(--text);
  }

  .atlas[data-scene] .atlas-lemma .atlas-name {
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.15;
  }

  .atlas[data-scene] .atlas-context {
    grid-column: 2;
    font-size: var(--text-2xs);
    color: var(--muted);
  }

  .atlas[data-scene] .atlas-leader {
    display: none;
  }

  .atlas[data-scene] .atlas-result {
    display: block;
    padding: 0.4375rem 0.5625rem 0.5rem;
    color: var(--muted);
  }

  .atlas[data-scene] .atlas-lemma:hover,
  .atlas[data-scene] .atlas-lemma[aria-expanded='true'] {
    border-color: var(--mark);
    box-shadow: 3px 3px 0 var(--mark);
  }

  .atlas[data-scene] .atlas-lemma[aria-expanded='true'] .atlas-lemma-head {
    border-bottom-color: var(--mark);
  }

  /* A part of the site: its kind, as a paper would label it, then its name. */
  .atlas[data-scene] .atlas-part {
    z-index: 3;
    display: grid;
    padding: 0.375rem 0.75rem 0.4375rem;
    border: 1px solid var(--line-strong);
    background: var(--panel);
    font-size: var(--text-sm);
    line-height: 1.2;
    white-space: nowrap;
  }

  .atlas[data-scene] .atlas-kind {
    font-style: italic;
    font-size: var(--text-xs);
    color: var(--muted);
  }

