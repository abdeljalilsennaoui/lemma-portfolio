---
import Icon from './Icon.astro';
import { links } from '../config/site';
import type { Locale } from '../i18n';
import { ui } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = ui.contact;
---

<section id="contact" class="contact board" aria-labelledby="contact-title">
  <div class="shell">
    <div class="sheet">
      <div class="margin-note">
        <p class="contact-kind-label">{ui.atlas.kinds.corollary[locale]}.</p>
        <h2 id="contact-title" class="margin-key">{strings.title[locale]}</h2>
      </div>
      <div class="sheet-body contact-grid">
      <p class="contact-body">{strings.body[locale]}</p>

      <ul class="contact-links">
        {
          links.email && (
            <li>
              <span class="contact-kind">{strings.email[locale]}</span>
              <a class="link" href={`mailto:${links.email}`}>
                <Icon name="mail" />
                {links.email}
              </a>
            </li>
          )
        }
        <li>
          <span class="contact-kind">{strings.github[locale]}</span>
          <a class="link" href={links.github} rel="me noopener">
            <Icon name="github" />
            github.com/{links.githubHandle}
          </a>
        </li>
        {
          links.linkedin && (
            <li>
              <span class="contact-kind">{strings.linkedin[locale]}</span>
              <a class="link" href={links.linkedin} rel="me noopener">
                <Icon name="linkedin" />
                {links.linkedin.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}
              </a>
            </li>
          )
        }
      </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /* The page ends at the blackboard, in either theme. On the board theme
     there is no colour change to mark the band, so a rule does that job. */
  .contact {
    background-image: none;
  }

  :global(:root[data-theme='dark']) .contact {
    border-top: 1.5px solid var(--text);
  }

  .contact-kind-label {
    font-style: italic;
  }

  .contact-grid {
    display: grid;
    gap: 2.5rem;
  }

  .contact-grid > * {
    min-width: 0;
  }

  .contact-body {
    max-width: 36rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.5rem, 3vw, 2.125rem);
    line-height: 1.3;
  }

  .contact-links {
    display: grid;
    align-self: start;
    align-content: start;
    border-top: 2px solid var(--text);
    border-bottom: 2px solid var(--text);
  }

  .contact-links li {
    display: grid;
    gap: 0.125rem;
    padding-block: 0.875rem;
  }

  .contact-links li + li {
    border-top: 1px solid var(--line);
  }

  .contact-kind {
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .contact-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    font-size: var(--text-lg);
    overflow-wrap: anywhere;
  }

  @media (min-width: 72rem) {
    .contact-grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: 3.5rem;
    }
  }
</style>
