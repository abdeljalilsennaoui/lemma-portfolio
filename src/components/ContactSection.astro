---
import Icon from './Icon.astro';
import { links } from '../config/site';
import type { Locale } from '../i18n';
import { ui } from '../i18n/ui';

interface Props {
  locale: Locale;
  number: number;
}

const { locale, number } = Astro.props;
const strings = ui.contact;
---

<section id="contact" class="contact board" aria-labelledby="contact-title">
  <div class="shell">
    <h2 id="contact-title"><span class="contact-number">{number}</span>{' '}{strings.title[locale]}</h2>

    <div class="contact-grid">
      <p class="contact-body">{strings.body[locale]}</p>

      <ul class="contact-links">
        {
          links.email && (
            <li>
              <span class="contact-kind">{strings.email[locale]}</span>
              <a class="link" href={`mailto:${links.email}`}>
                <Icon name="mail" />
                {links.email}
              </a>
            </li>
          )
        }
        <li>
          <span class="contact-kind">{strings.github[locale]}</span>
          <a class="link" href={links.github} rel="me noopener">
            <Icon name="github" />
            github.com/{links.githubHandle}
          </a>
        </li>
        {
          links.linkedin && (
            <li>
              <span class="contact-kind">{strings.linkedin[locale]}</span>
              <a class="link" href={links.linkedin} rel="me noopener">
                <Icon name="linkedin" />
                {links.linkedin.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}
              </a>
            </li>
          )
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .contact {
    margin-top: clamp(4rem, 9vw, 7rem);
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }

  /* On the blackboard theme the band has no colour change to mark it, so a
     rule does that job. */
  :global(:root:not([data-theme='light'])) .contact {
    border-top: 2px solid var(--text);
  }

  h2 {
    font-family: var(--font-serif);
    font-size: clamp(2.125rem, 5vw, 3.125rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  .contact-number {
    margin-right: 0.3em;
  }

  .contact-grid {
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(1.75rem, 4vw, 2.75rem);
  }

  .contact-body {
    max-width: 36rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.5rem, 3vw, 2.125rem);
    line-height: 1.3;
  }

  .contact-links {
    display: grid;
    align-content: start;
    border-top: 2px solid var(--text);
    border-bottom: 2px solid var(--text);
  }

  .contact-links li {
    display: grid;
    gap: 0.125rem;
    padding-block: 0.875rem;
  }

  .contact-links li + li {
    border-top: 1px solid var(--line);
  }

  .contact-kind {
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .contact-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    font-size: var(--text-lg);
    overflow-wrap: anywhere;
  }

  @media (min-width: 64rem) {
    .contact-grid {
      grid-template-columns: 7fr 5fr;
      gap: 5rem;
    }
  }
</style>
