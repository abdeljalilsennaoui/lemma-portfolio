---
import { Image } from 'astro:assets';
import LayerDiagram from './LayerDiagram.astro';
import type { Locale } from '../i18n';
import type { Project } from '../types/content';

/**
 * The picture for a project on the home page, framed on the sheet: its real screenshot when
 * it has one, and its architecture diagram, captioned as a diagram, when it
 * does not.
 */
interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
---

<div class:list={['plate frame', { 'plate-diagram': !project.cover }]}>
  {
    project.cover ? (
      <Image
        src={project.cover.src}
        alt={project.cover.alt[locale]}
        widths={[480, 800, 1200, 1600]}
        sizes="(min-width: 78rem) 58rem, 92vw"
        loading={project.order === 1 ? 'eager' : 'lazy'}
        class="shot"
        style={`max-width: ${project.cover.src.width}px`}
      />
    ) : (
      <LayerDiagram diagram={project.architecture.diagram} locale={locale} compact />
    )
  }
</div>

<style>
  .plate {
    padding: clamp(0.375rem, 1vw, 0.625rem);
  }

  .plate-diagram {
    padding: clamp(1.25rem, 4vw, 2.5rem);
  }

  /* Never wider than the file itself: a small screenshot sits centred on the
     panel instead of being stretched soft. */
  .shot {
    display: block;
    width: 100%;
    height: auto;
    margin-inline: auto;
  }
</style>
