---
import Icon from './Icon.astro';
import Section from './Section.astro';
import { gdg } from '../data/community';
import { languageTag, type Locale } from '../i18n';
import { ui } from '../i18n/ui';

/**
 * Involvement outside coursework: the executive role at GDG on Campus
 * Concordia, and what the chapter put on. Everything here is read from
 * `src/data/community.ts`.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = ui.community;

const dateFormat = new Intl.DateTimeFormat(languageTag[locale], {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
const numberFormat = new Intl.NumberFormat(languageTag[locale]);
const fill = (text: string) =>
  text.replace('{members}', numberFormat.format(gdg.members.count)).replace('{asOf}', gdg.members.asOf[locale]);
---

<Section
  id="community"
  title={strings.title[locale]}
  intro={strings.intro[locale]}
  kind={ui.atlas.kinds.remark[locale]}
>
  <div class="community">
    <div class="community-text">
      <p class="statement">
        <span class="theorem-label">{gdg.name[locale]}.</span>{' '}
        <span class="theorem-body">{gdg.role[locale]}, {gdg.since[locale]}.</span>
      </p>
      {strings.paragraphs.map((paragraph) => <p>{fill(paragraph[locale])}</p>)}
      <ul class="community-links">
        <li>
          <a class="link" href={gdg.url} rel="noopener">
            {strings.chapterPage[locale]}
            <Icon name="external" size={14} />
          </a>
        </li>
        <li>
          <a class="link" href={gdg.instagram} rel="noopener">
            Instagram
            <Icon name="external" size={14} />
          </a>
        </li>
      </ul>
    </div>

    <div>
      <table class="booktabs events">
        <thead>
          <tr>
            <th scope="col">{strings.dateHead[locale]}</th>
            <th scope="col">{strings.eventsHead[locale]}</th>
          </tr>
        </thead>
        <tbody>
          {
            gdg.events.map((event) => (
              <tr>
                <th scope="row">
                  <time datetime={event.date}>{dateFormat.format(new Date(event.date))}</time>
                </th>
                <td>
                  <a class="link event-name" href={event.url} rel="noopener">
                    {event.name}
                  </a>
                  {event.partners && <span class="event-partners">, {event.partners[locale]}</span>}
                  {event.helpedRun && (
                    <span class="event-mine">
                      <span class="tombstone" aria-hidden="true" />
                      {strings.helpedRun[locale]}
                    </span>
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="caption">
        <span class="caption-label">{ui.work.table[locale]}&nbsp;1.</span>{' '}
        {strings.eventsCaption[locale]}
      </p>
    </div>
  </div>
</Section>

<style>
  .community {
    display: grid;
    gap: 2.5rem;
  }

  .community > * {
    min-width: 0;
  }

  .community-text {
    display: grid;
    gap: 1.125rem;
    align-content: start;
    max-width: 40rem;
  }

  .community-text p {
    color: var(--muted);
  }

  .community-text .statement {
    margin-bottom: 0.25rem;
    font-size: clamp(1.4375rem, 2.5vw, 1.75rem);
    line-height: 1.3;
    color: var(--text);
  }

  .community-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.75rem;
    font-size: var(--text-sm);
  }

  .community-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
  }

  .events {
    background: var(--panel);
  }

  .events :is(th, td) {
    padding-left: 0.875rem;
  }

  .events tbody th {
    width: 7.5rem;
    white-space: nowrap;
  }

  /* The events I helped run carry the mark and say so. */
  .event-mine {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
    color: var(--text);
  }

  .event-mine .tombstone {
    width: 0.4375rem;
    height: 0.4375rem;
  }

  .event-name {
    color: var(--text);
  }

  .event-partners {
    color: var(--muted);
  }

  @media (min-width: 72rem) {
    .community {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: 3.5rem;
      align-items: start;
    }
  }
</style>
