---
import ProjectEntry from './ProjectEntry.astro';
import { projects } from '../data/projects';
import type { Locale } from '../i18n';
import { ui } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section id="work" class="shell" aria-labelledby="work-title">
  <div class="sheet sheet-rule heading">
    <div class="margin-note">
      <h2 id="work-title" class="margin-key">{ui.work.title[locale]}</h2>
    </div>
    <div class="sheet-body">
      <p class="intro">{ui.work.intro[locale]}</p>
    </div>
  </div>
  {projects.map((project) => <ProjectEntry project={project} locale={locale} />)}
</section>

<style>
  /* The heading row is short: it only introduces the entries below it. */
  .heading > .sheet-body {
    padding-bottom: 0;
  }

  .intro {
    max-width: 34rem;
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--muted);
  }
</style>
