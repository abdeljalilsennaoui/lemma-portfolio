---
import Section from './Section.astro';
import { principles } from '../data/principles';
import { getProject, projects } from '../data/projects';
import { lemmaId } from '../data/system';
import { skillGroups } from '../data/skills';
import type { Locale } from '../i18n';
import { ui } from '../i18n/ui';
import type { Evidence } from '../types/content';
import { href } from '../utils/paths';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = ui.engineering;

// Turn an evidence pointer into a citation: "L2" for a case study on this
// site, or the repository name for anything outside it.
function resolve(evidence: Evidence) {
  if (evidence.kind === 'link') {
    return { text: evidence.label, url: evidence.url, title: evidence.label, external: true };
  }
  const project = getProject(evidence.slug);
  if (!project) throw new Error(`Unknown project in skills evidence: ${evidence.slug}`);
  return {
    text: `L${project.order}`,
    url: href(`/work/${project.slug}/`, locale),
    title: project.title,
    external: false,
  };
}
---

<Section
  id="engineering"
  title={strings.title[locale]}
  intro={strings.intro[locale]}
  kind={ui.atlas.kinds.axioms[locale]}
>
  <div class="engineering">
    <div>
      <h3 class="subheading">{strings.principles[locale]}</h3>
      <ul class="principles">
        {
          principles.map((principle, index) => (
            <li>
              <span class="theorem-label">
                {strings.axiom[locale]}&nbsp;{index + 1}
              </span>{' '}
              <span class="axiom-name">({principle.name[locale]})</span>
              <span class="theorem-label">.</span> {principle.statement[locale]}
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class="subheading">{strings.skills[locale]}</h3>
      <div class="skill-filter" role="group" aria-label={strings.filter[locale]} data-skill-filter hidden>
        <span class="skill-filter-label">{strings.filter[locale]}</span>
        <button type="button" data-lemma="" aria-pressed="true">{strings.all[locale]}</button>
        {
          projects.map((project) => (
            <button type="button" data-lemma={lemmaId(project)} aria-pressed="false" title={project.title}>
              <span class="skill-filter-id" aria-hidden="true">
                {lemmaId(project)}
              </span>
              {project.shortTitle}
            </button>
          ))
        }
        <span class="skill-filter-count" data-skill-count data-text={strings.filtered[locale]} aria-live="polite" />
      </div>
      <table class="booktabs skills" data-skills>
        <thead>
          <tr>
            <th scope="col">{strings.area[locale]}</th>
            <th scope="col">{strings.skillsHead[locale]}</th>
          </tr>
        </thead>
        <tbody>
          {
            skillGroups.map((group) => (
              <tr>
                <th scope="row">{group.label[locale]}</th>
                <td>
                  <ul>
                    {group.skills.map((skill) => (
                      <li
                        data-lemmas={skill.evidence
                          .map((item) => (item.kind === 'project' ? getProject(item.slug) : undefined))
                          .filter((project) => project !== undefined)
                          .map((project) => lemmaId(project))
                          .join(' ')}
                      >
                        {skill.name}{' '}
                        <span class="cite">
                          {'['}
                          {skill.evidence.map(resolve).map((item, index) => (
                            <>
                              {index > 0 && ', '}
                              <a href={item.url} rel={item.external ? 'noopener' : undefined} title={item.title}>
                                {item.text}
                                {!item.external && <span class="sr-only">, {item.title}</span>}
                              </a>
                            </>
                          ))}
                          {']'}
                        </span>
                      </li>
                    ))}
                  </ul>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="caption">
        <span class="caption-label">{ui.work.table[locale]}&nbsp;2.</span>{' '}
        {strings.evidenceHint[locale]}
      </p>
    </div>

  </div>
</Section>

<script>
  // The skills can be narrowed to those seen in one project. The control is
  // here, and selecting a project in the figure at the top of the page sets
  // it too (the figure announces its selection with an `atlas:select` event).
  const filter = document.querySelector<HTMLElement>('[data-skill-filter]');
  const table = document.querySelector<HTMLElement>('[data-skills]');
  if (filter && table) {
    const count = filter.querySelector<HTMLElement>('[data-skill-count]');
    const skills = [...table.querySelectorAll<HTMLElement>('li[data-lemmas]')];
    const show = (lemma: string) => {
      let matched = 0;
      for (const skill of skills) {
        const on = !lemma || (skill.dataset.lemmas ?? '').split(' ').includes(lemma);
        skill.toggleAttribute('data-off', !on);
        if (on) matched += 1;
      }
      for (const button of filter.querySelectorAll<HTMLButtonElement>('button')) {
        button.setAttribute('aria-pressed', String((button.dataset.lemma ?? '') === lemma));
      }
      if (count) {
        count.textContent = lemma
          ? (count.dataset.text ?? '').replace('{n}', String(matched)).replace('{total}', String(skills.length))
          : '';
      }
    };
    filter.hidden = false;
    filter.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-lemma]');
      if (button) show(button.dataset.lemma ?? '');
    });
    document.addEventListener('atlas:select', (event) => {
      const id = (event as CustomEvent<string | null>).detail ?? '';
      show(/^L\d+$/.test(id) ? id : '');
    });
  }
</script>

<style>
  .skill-filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.5rem;
    margin-top: 1.25rem;
    font-size: var(--text-sm);
  }

  .skill-filter[hidden] {
    display: none;
  }

  .skill-filter + .skills {
    margin-top: 0.75rem;
  }

  .skill-filter-label {
    margin-right: 0.25rem;
    color: var(--muted);
  }

  .skill-filter button {
    display: inline-flex;
    align-items: baseline;
    gap: 0.375rem;
    min-height: 2.25rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--line-strong);
    background: var(--panel);
    color: var(--text);
    transition:
      border-color 150ms ease,
      background-color 150ms ease,
      color 150ms ease;
  }

  .skill-filter button:hover {
    border-color: var(--mark);
  }

  .skill-filter button[aria-pressed='true'] {
    border-color: var(--text);
    background: var(--text);
    color: var(--bg);
  }

  .skill-filter-id {
    font-style: italic;
    opacity: 0.75;
  }

  .skill-filter-count {
    margin-left: 0.5rem;
    color: var(--muted);
  }

  .skills li {
    transition: opacity 200ms ease;
  }

  .skills li[data-off] {
    opacity: 0.25;
  }

  .engineering {
    display: grid;
    gap: 3.5rem;
  }

  .engineering > * {
    min-width: 0;
  }

  .subheading {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.2;
  }

  .principles {
    display: grid;
    gap: 1.125rem 3rem;
    margin-top: 1.25rem;
    color: var(--muted);
  }

  .principles li {
    max-width: 30rem;
  }

  @media (min-width: 48rem) {
    .principles {
      grid-template-columns: 1fr 1fr;
    }
  }

  .principles :is(.theorem-label, .axiom-name) {
    color: var(--text);
  }

  .skills {
    margin-top: 1.25rem;
    background: var(--panel);
  }

  .skills :is(th, td) {
    padding-left: 0.875rem;
  }

  .skills tbody th {
    width: 9.5rem;
  }

  .skills ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.125rem;
  }

  .skills li {
    white-space: nowrap;
  }

  /* Evidence is cited the way a paper cites its references. */
  .cite {
    font-size: var(--text-xs);
    color: var(--muted);
    white-space: normal;
  }

  .cite a {
    display: inline-block;
    /* A target at least 24px wide, pulled in so the brackets still sit close.
       The side padding keeps a long label clear of them. */
    min-width: 1.5rem;
    margin-inline: -0.2rem;
    padding: 0.3rem 0.25rem;
    text-align: center;
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }

  .cite a:hover {
    text-decoration-color: var(--mark);
    text-decoration-thickness: 2px;
  }

  @media (max-width: 39.99rem) {
    /* On narrow screens each area stacks above its skills. */
    .skills thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .skills tbody tr {
      display: grid;
    }

    .skills tbody th {
      width: auto;
      padding-bottom: 0;
      border-top: 0;
    }

    .skills tbody tr + tr {
      border-top: 1px solid var(--line);
    }

    .skills tbody tr + tr > * {
      border-top: 0;
    }

    .skills tbody td {
      padding-top: 0.25rem;
    }
  }

</style>
