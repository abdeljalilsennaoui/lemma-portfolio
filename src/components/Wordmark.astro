---
import { brand } from '../config/site';
import { ui } from '../i18n/ui';
import type { Locale } from '../i18n';
import { href } from '../utils/paths';

/**
 * The "lemma." wordmark. Its full stop is drawn as a tombstone, the square
 * that closes a proof.
 */
interface Props {
  locale: Locale;
  signature?: boolean;
}

const { locale, signature = true } = Astro.props;
---

<a href={href('/', locale)} class="wordmark">
  <span class="wordmark-name">{brand.wordmark}<span class="tombstone" aria-hidden="true"></span></span>
  {signature && <span class="wordmark-signature">{brand.signature}</span>}
  <span class="sr-only">, {ui.nav.home[locale]}</span>
</a>

<style>
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.75rem;
    color: var(--text);
    white-space: nowrap;
  }

  .wordmark-name {
    font-family: var(--font-serif);
    font-size: 1.875rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .wordmark-name .tombstone {
    width: 0.26em;
    height: 0.26em;
    margin-left: 0.09em;
  }

  .wordmark-signature {
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    color: var(--muted);
  }

  @media (max-width: 30rem) {
    .wordmark-name {
      font-size: 1.625rem;
    }
  }
</style>
