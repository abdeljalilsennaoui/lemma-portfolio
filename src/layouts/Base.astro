---
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-400-italic.css';
import '@fontsource/barlow/latin-600.css';
import '@fontsource/barlow/latin-700.css';
import '@fontsource/barlow-condensed/latin-700.css';
import '@fontsource/barlow-condensed/latin-700-italic.css';
import '../styles/global.css';

import textUrl from '@fontsource/barlow/files/barlow-latin-400-normal.woff2?url';
import displayUrl from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { brand, links, person, seo } from '../config/site';
import { gdg } from '../data/community';
import { defaultLocale, languageTag, locales, type Locale } from '../i18n';
import { ui } from '../i18n/ui';
import { absolute, asset, href } from '../utils/paths';

// Pages of this site are fetched ahead when the reader points at a link to
// one, so the click that follows has nothing left to wait for.
const speculationRules = {
  prefetch: [{ where: { href_matches: href('/*') }, eagerness: 'moderate' }],
};

interface Props {
  locale: Locale;
  /** Path of this page without base or language prefix, e.g. "/work/summs/". */
  route: string;
  /** Page title. The home page passes none and gets the full site title. */
  title?: string;
  description?: string;
  /** Social image, as a path with base. Defaults to the site image. */
  image?: string;
  /** Its size and description, when it is not the site image. */
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const {
  locale,
  route,
  title,
  description = seo.description[locale],
  image = asset(seo.ogImage),
  imageWidth = 1200,
  imageHeight = 630,
  imageAlt = `${brand.name} — ${person.name}`,
  ogType = 'website',
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} | ${person.name} — ${brand.name}` : seo.title[locale];
const canonical = absolute(href(route, locale), Astro.site);
const sameAs = [links.github, links.linkedin].filter((url): url is string => Boolean(url));

// LEMMA is a personal identity, so the structured data describes a Person
// and their website. It deliberately does not declare an Organization.
const personId = absolute(href('/'), Astro.site) + '#person';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: person.name,
      givenName: person.givenName,
      familyName: person.familyName,
      url: absolute(href('/'), Astro.site),
      description: person.role[locale],
      affiliation: {
        '@type': 'CollegeOrUniversity',
        name: person.school.name[locale],
        url: person.school.url,
      },
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Montreal',
        addressRegion: 'QC',
        addressCountry: 'CA',
      },
      memberOf: {
        '@type': 'Organization',
        name: gdg.name[locale],
        url: gdg.url,
      },
      knowsAbout: [
        'Software engineering',
        'Software testing',
        'Test automation',
        'Back-end development',
        'Software architecture',
      ],
      sameAs,
    },
    {
      '@type': 'WebSite',
      '@id': absolute(href('/'), Astro.site) + '#website',
      url: absolute(href('/'), Astro.site),
      name: brand.name,
      description: seo.description[locale],
      inLanguage: locales.map((code) => languageTag[code]),
      author: { '@id': personId },
    },
  ],
};
---

<!doctype html>
<html lang={languageTag[locale]} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={person.name} />
    {noindex && <meta name="robots" content="noindex" />}

    {!noindex && <link rel="canonical" href={canonical} />}
    {
      !noindex &&
        locales.map((code) => (
          <link rel="alternate" hreflang={languageTag[code]} href={absolute(href(route, code), Astro.site)} />
        ))
    }
    {!noindex && <link rel="alternate" hreflang="x-default" href={absolute(href(route, defaultLocale), Astro.site)} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={languageTag[locale].replace('-', '_')} />
    <meta property="og:image" content={absolute(image, Astro.site)} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#912338" />
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={asset('/favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={asset('/apple-touch-icon.png')} />
    <link rel="sitemap" href={asset('/sitemap-index.xml')} />

    <link rel="preload" href={textUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayUrl} as="font" type="font/woff2" crossorigin />

    <!-- Picks the theme before first paint: a saved choice if there is one,
         otherwise the reader's system setting. Also marks the page as scripted. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') {
            root.dataset.theme = saved;
            return;
          }
        } catch (error) {
          /* Storage can be unavailable; fall through to the system setting. */
        }
        if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
          root.dataset.theme = 'dark';
        }
      })();
    </script>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <script type="speculationrules" is:inline set:html={JSON.stringify(speculationRules)} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-mark focus:px-4 focus:py-2 focus:text-mark-ink"
    >
      {ui.skipToContent[locale]}
    </a>
    <Header locale={locale} route={route} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />

    <script>
      // "You are here": marks the link, in any list tagged `data-spy`, whose
      // section is the one being read. Used by the header on the home page
      // and by the contents list of a case study.
      const pairs: { link: HTMLAnchorElement; target: HTMLElement }[] = [];
      for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-spy] a[href*="#"]')) {
        const url = new URL(link.href);
        if (url.pathname !== window.location.pathname) continue;
        const target = document.getElementById(decodeURIComponent(url.hash.slice(1)));
        if (target) pairs.push({ link, target });
      }

      if (pairs.length > 0) {
        let queued = false;
        const mark = () => {
          queued = false;
          // The current section is the last one whose top has passed a line a
          // third of the way down the window.
          const line = window.innerHeight / 3;
          let current: HTMLElement | undefined;
          for (const { target } of pairs) {
            if (target.getBoundingClientRect().top <= line) current = target;
          }
          for (const { link, target } of pairs) {
            if (target === current) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          }
        };
        const queue = () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(mark);
        };
        mark();
        window.addEventListener('scroll', queue, { passive: true });
        window.addEventListener('resize', queue, { passive: true });
      }
    </script>
  </body>
</html>
