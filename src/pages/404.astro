---
import { languageTag, locales } from '../i18n';
import { ui } from '../i18n/ui';
import Base from '../layouts/Base.astro';
import { href } from '../utils/paths';

// GitHub Pages serves this one file for every unknown address, whatever the
// language, so the message is shown in both. The route is "/" so that the
// header's language links lead home instead of to a missing page.
---

<Base locale="en" route="/" title={ui.notFound.title.en} noindex>
  <section class="shell not-found">
    <p class="code">404</p>
    {
      locales.map((locale) => (
        <div lang={languageTag[locale]}>
          <h1>{ui.notFound.title[locale]}</h1>
          <p>{ui.notFound.body[locale]}</p>
          <p>
            <a class="link" href={href('/', locale)}>
              {ui.notFound.home[locale]}
            </a>
          </p>
        </div>
      ))
    }
  </section>
</Base>

<style>
  .not-found {
    display: grid;
    gap: 2.5rem;
    max-width: 40rem;
    margin-inline: 0;
    padding-block: clamp(3rem, 10vw, 7rem);
  }

  .code {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: var(--text-xl);
    line-height: 1;
  }

  h1 {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    font-weight: 400;
    line-height: 1.05;
  }

  p {
    margin-top: 0.75rem;
    color: var(--muted);
  }

  p a {
    display: inline-block;
    padding-block: 0.375rem;
  }
</style>
