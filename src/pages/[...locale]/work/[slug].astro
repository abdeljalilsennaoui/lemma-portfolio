---
import { getImage } from 'astro:assets';
import Icon from '../../../components/Icon.astro';
import LayerDiagram from '../../../components/LayerDiagram.astro';
import Lightbox from '../../../components/Lightbox.astro';
import Attempts from '../../../components/Attempts.astro';
import Chunker from '../../../components/Chunker.astro';
import StateMachine from '../../../components/StateMachine.astro';
import Tally from '../../../components/Tally.astro';
import ZoomFigure from '../../../components/ZoomFigure.astro';
import { projects } from '../../../data/projects';
import { lemmaId, neighbours } from '../../../data/system';
import { defaultLocale, locales, localeFromParam } from '../../../i18n';
import { ui } from '../../../i18n/ui';
import Base from '../../../layouts/Base.astro';
import type { Project } from '../../../types/content';
import { href } from '../../../utils/paths';

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    projects.map((project) => ({
      params: { locale: locale === defaultLocale ? undefined : locale, slug: project.slug },
      props: { project },
    })),
  );
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const locale = localeFromParam(Astro.params.locale);
const strings = ui.caseStudy;
const figureLabel = ui.work.figure[locale];

// The other projects, ordered by how much they share with this one.
const related = neighbours(project);

// Figures are numbered in reading order: the cover (the architecture diagram
// when there is no screenshot), then the gallery, then the architecture
// diagram when it was not already the cover.
const gallery = project.gallery ?? [];
const firstGalleryFigure = 2;
const diagramFigure = project.cover ? firstGalleryFigure + gallery.length : 1;
// The figure a project has of its own (a model to drive, a count, the
// versions of a fix) comes after those. A project has one at most.
const modelFigure = Math.max(diagramFigure, firstGalleryFigure + gallery.length - 1) + 1;

// A link to this page shared elsewhere shows the project's own picture. It is
// never enlarged, so the size reported with it is worked out here.
const socialWidth = project.cover ? Math.min(1200, project.cover.src.width) : undefined;
const socialHeight =
  project.cover && socialWidth
    ? Math.round((project.cover.src.height * socialWidth) / project.cover.src.width)
    : undefined;
const social = project.cover
  ? await getImage({ src: project.cover.src, width: socialWidth, format: 'png' })
  : undefined;

// The contents list follows the movements of a proof: what is claimed, how
// it was built, how it was checked, and what came of it.
const entry = (id: keyof typeof strings.sections) => ({ id, label: strings.sections[id][locale] });
const outline = [
  {
    label: strings.outline.statement[locale],
    sections: [entry('overview'), ...(gallery.length > 0 ? [entry('gallery')] : []), entry('problem'), entry('goals')],
  },
  {
    label: strings.outline.construction[locale],
    sections: [entry('technologies'), entry('architecture'), entry('role'), entry('decisions')],
  },
  {
    label: strings.outline.verification[locale],
    sections: [entry('testing'), entry('challenges')],
  },
  {
    label: strings.outline.conclusion[locale],
    sections: [entry('results'), entry('links')],
  },
];
---

<Base
  locale={locale}
  route={`/work/${project.slug}/`}
  title={`${project.title} — ${strings.titleSuffix[locale]}`}
  description={project.summary[locale]}
  ogType="article"
  image={social?.src}
  imageWidth={socialWidth}
  imageHeight={socialHeight}
  imageAlt={project.cover?.alt[locale]}
>
  <article class="shell case">
    <header class="case-header">
      <p>
        <a class="back" href={href('/#work', locale)}>
          <Icon name="arrow-left" size={16} />
          {strings.allWork[locale]}
        </a>
      </p>
      <p class="case-number theorem-label">{ui.work.lemma[locale]}&nbsp;{project.order}</p>
      <h1>{project.title}</h1>
      <p class="case-summary theorem-body">{project.summary[locale]}</p>

      <dl class="case-meta">
        <div>
          <dt>{strings.result[locale]}</dt>
          <dd>
            <span class="hl">{project.proof.figure[locale]}</span>{' '}
            {project.proof.claim[locale]}
          </dd>
        </div>
        <div>
          <dt>{strings.meta.context[locale]}</dt>
          <dd>{project.context.label[locale]}</dd>
        </div>
        <div>
          <dt>{strings.meta.period[locale]}</dt>
          <dd>{project.period[locale]}</dd>
        </div>
        <div>
          <dt>{strings.meta.repository[locale]}</dt>
          <dd>
            <a class="link repo" href={project.repository.url} target="_blank" rel="noopener">
              {project.repository.label}
              <span class="sr-only">({ui.work.opensInNewTab[locale]})</span>
              <Icon name="external" size={14} />
            </a>
          </dd>
        </div>
      </dl>
    </header>

    <div class="case-cover">
      {
        project.cover ? (
          <ZoomFigure
            figure={project.cover}
            number={1}
            locale={locale}
            sizes="(min-width: 78rem) 72rem, 92vw"
            eager
            transitionName={`figure-${project.slug}`}
          />
        ) : (
          <figure>
            <div class="frame figure-diagram" style={`view-transition-name: figure-${project.slug}`}>
              <LayerDiagram diagram={project.architecture.diagram} locale={locale} />
            </div>
            <figcaption class="caption">
              <span class="caption-label">{figureLabel}&nbsp;1.</span>{' '}
              {project.architecture.diagram.caption[locale]}
            </figcaption>
          </figure>
        )
      }
    </div>

    <div class="case-layout">
      <nav class="toc" aria-label={strings.contents[locale]}>
        <p class="toc-title">{strings.contents[locale]}</p>
        <ol class="movements" data-spy>
          {
            outline.map((movement) => (
              <li class="movement">
                <span class="movement-label">{movement.label}</span>
                <ol>
                  {movement.sections.map((section) => (
                    <li>
                      <a href={`#${section.id}`}>{section.label}</a>
                    </li>
                  ))}
                </ol>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="case-body">
        <section id="overview" aria-labelledby="overview-title">
          <h2 id="overview-title">{strings.sections.overview[locale]}</h2>
          {project.overview.map((paragraph) => <p>{paragraph[locale]}</p>)}
        </section>

        {
          gallery.length > 0 && (
            <section id="gallery" class="wide" aria-labelledby="gallery-title">
              <h2 id="gallery-title">{strings.sections.gallery[locale]}</h2>
              <div class="gallery">
                {gallery.map((figure, galleryIndex) => (
                  <ZoomFigure
                    figure={figure}
                    number={firstGalleryFigure + galleryIndex}
                    locale={locale}
                    sizes="(min-width: 78rem) 30rem, (min-width: 48rem) 44vw, 92vw"
                  />
                ))}
              </div>
            </section>
          )
        }

        <section id="problem" aria-labelledby="problem-title">
          <h2 id="problem-title">{strings.sections.problem[locale]}</h2>
          {project.problem.map((paragraph) => <p>{paragraph[locale]}</p>)}
        </section>

        <section id="goals" aria-labelledby="goals-title">
          <h2 id="goals-title">{strings.sections.goals[locale]}</h2>
          <ul class="bullets">
            {project.goals.map((goal) => <li>{goal[locale]}</li>)}
          </ul>
        </section>

        <section id="technologies" aria-labelledby="technologies-title">
          <h2 id="technologies-title">{strings.sections.technologies[locale]}</h2>
          <table class="booktabs tech">
            <tbody>
              {
                project.technologies.map((group) => (
                  <tr>
                    <th scope="row">{group.group[locale]}</th>
                    <td>{group.items.join(', ')}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </section>

        <section id="architecture" aria-labelledby="architecture-title">
          <h2 id="architecture-title">{strings.sections.architecture[locale]}</h2>
          {project.architecture.body.map((paragraph) => <p>{paragraph[locale]}</p>)}
          {
            // Projects without a screenshot already show this diagram as Figure 1.
            project.cover && (
              <figure class="figure">
                <div class="frame figure-diagram">
                  <LayerDiagram diagram={project.architecture.diagram} locale={locale} />
                </div>
                <figcaption class="caption">
                  <span class="caption-label">
                    {figureLabel}&nbsp;{diagramFigure}.
                  </span>{' '}
                  {project.architecture.diagram.caption[locale]}
                </figcaption>
              </figure>
            )
          }
        </section>

        <section id="role" aria-labelledby="role-title">
          <h2 id="role-title">{strings.sections.role[locale]}</h2>
          <p>{project.role.summary[locale]}</p>
          <ul class="bullets">
            {project.role.contributions.map((item) => <li>{item[locale]}</li>)}
          </ul>
          <p class="aside">{project.role.evidence[locale]}</p>
        </section>

        <section id="decisions" aria-labelledby="decisions-title">
          <h2 id="decisions-title">{strings.sections.decisions[locale]}</h2>
          {
            project.decisions.map((decision) => (
              <div class="note">
                <h3>{decision.title[locale]}</h3>
                <p>{decision.body[locale]}</p>
                {decision.machine && <StateMachine machine={decision.machine} locale={locale} number={modelFigure} />}
              </div>
            ))
          }
        </section>

        <section id="testing" aria-labelledby="testing-title">
          <h2 id="testing-title">{strings.sections.testing[locale]}</h2>
          {project.testing.map((paragraph) => <p>{paragraph[locale]}</p>)}
          {project.tally && <Tally tally={project.tally} locale={locale} number={modelFigure} />}
        </section>

        <section id="challenges" aria-labelledby="challenges-title">
          <h2 id="challenges-title">{strings.sections.challenges[locale]}</h2>
          {
            project.challenges.map((challenge) => (
              <div class="note">
                <h3>{challenge.title[locale]}</h3>
                <p>{challenge.body[locale]}</p>
                {challenge.attempts && <Attempts attempts={challenge.attempts} locale={locale} number={modelFigure} />}
                {challenge.chunker && <Chunker chunker={challenge.chunker} locale={locale} number={modelFigure} />}
              </div>
            ))
          }
        </section>

        <section id="results" aria-labelledby="results-title">
          <h2 id="results-title">{strings.sections.results[locale]}</h2>
          <table class="booktabs results">
              <thead>
                <tr>
                  <th scope="col">{strings.results.measure[locale]}</th>
                  <th scope="col">{strings.results.value[locale]}</th>
                  <th scope="col">{strings.results.source[locale]}</th>
                </tr>
              </thead>
              <tbody>
                {
                  project.results.rows.map((row) => (
                    <tr>
                      <th scope="row">{row.label[locale]}</th>
                      <td>{row.value[locale]}</td>
                      <td class="source">{row.source[locale]}</td>
                    </tr>
                  ))
                }
              </tbody>
          </table>
          <p class="caption">
            <span class="caption-label">{ui.work.table[locale]}&nbsp;1.</span>{' '}
            {project.results.note[locale]}
          </p>
          {
            project.limitations && (
              <>
                <h3>{strings.limitations[locale]}</h3>
                <ul class="bullets">
                  {project.limitations.map((item) => (
                    <li>{item[locale]}</li>
                  ))}
                </ul>
              </>
            )
          }
        </section>

        <section id="links" aria-labelledby="links-title">
          <h2 id="links-title">{strings.sections.links[locale]}</h2>
          <p>
            <a class="link repo" href={project.repository.url} target="_blank" rel="noopener">
              <Icon name="github" size={18} />
              {project.repository.label}
              <span class="sr-only">({ui.work.opensInNewTab[locale]})</span>
              <Icon name="external" size={14} />
            </a>
          </p>
          {project.repository.note && <p class="aside">{project.repository.note[locale]}</p>}
          {
            project.demo ? (
              <p>
                <a class="link repo" href={project.demo.url} target="_blank" rel="noopener">
                  {project.demo.label[locale]}
                  <span class="sr-only">({ui.work.opensInNewTab[locale]})</span>
                  <Icon name="external" size={14} />
                </a>
              </p>
            ) : (
              <p class="aside">{strings.noDemo[locale]}</p>
            )
          }
        </section>

        <p class="qed">
          <span class="tombstone" aria-hidden="true"></span><span class="sr-only">{strings.endOfProof[locale]}</span>
        </p>
      </div>
    </div>

    <nav class="related" aria-labelledby="related-title">
      <div class="related-head">
        <h2 id="related-title">{strings.related.title[locale]}</h2>
        <p>{strings.related.intro[locale]}</p>
      </div>
      <ul class="related-list">
        {
          related.map(({ project: other, shared }) => (
            <li>
              <a href={href(`/work/${other.slug}/`, locale)}>
                <span class="related-name">
                  <span class="theorem-label">
                    {ui.work.lemma[locale]}&nbsp;{other.order}
                  </span>{' '}
                  ({other.shortTitle})
                </span>
                <span class="related-result">
                  {other.proof.figure[locale]} {other.proof.claim[locale]}
                </span>
                <span class="related-shared">
                  <span class="related-count">
                    {shared.length > 0
                      ? strings.related.shared[locale].replace('{n}', String(shared.length))
                      : strings.related.none[locale]}
                  </span>
                  {shared.length > 0 && <span class="sr-only">: </span>}
                  {shared.map((discipline) => (
                    <span class="related-pair">
                      <span class="tombstone" aria-hidden="true" />
                      {discipline.label[locale]}
                    </span>
                  ))}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="related-figure">
        <a class="link" href={href(`/#${lemmaId(project)}`, locale)}>
          {strings.related.inFigure[locale]}
        </a>
      </p>
    </nav>
  </article>
  <Lightbox locale={locale} />
</Base>

<style>
  .case {
    padding-top: clamp(1.5rem, 4vw, 3rem);
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    font-size: var(--text-sm);
    color: var(--muted);
    transition: color 150ms ease;
  }

  .back:hover {
    color: var(--text);
  }

  .case-number {
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    font-size: var(--text-xl);
    line-height: 1;
  }

  h1 {
    margin-top: 0.5rem;
    max-width: 20ch;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .case-summary {
    margin-top: 1.5rem;
    max-width: 44rem;
    font-size: clamp(1.3125rem, 2.4vw, 1.625rem);
    line-height: 1.38;
  }

  /* The same ruled block as the top of the home page, here for the project. */
  .case-meta {
    display: grid;
    margin-top: 2.5rem;
    border: 1.5px solid var(--text);
    background: var(--panel);
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  .case-meta > div {
    padding: 0.625rem 0.875rem 0.75rem;
  }

  .case-meta > div + div {
    border-top: 1px solid var(--line-strong);
  }

  .case-meta dt {
    font-size: var(--text-2xs);
  }

  .case-meta dd {
    margin-top: 0.125rem;
  }

  .case-meta dt {
    color: var(--muted);
  }

  /* Inline, so the icons stay with the text when a long name wraps. */
  .repo {
    padding-block: 0.25rem;
    overflow-wrap: anywhere;
  }

  .repo :global(svg) {
    display: inline;
    vertical-align: -0.15em;
    margin-inline: 0.15em;
  }

  .case-cover {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .case-layout {
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  /* On small screens the contents list is a compact two-column index. */
  .toc {
    padding-block: 1rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    font-size: var(--text-sm);
  }

  .toc-title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: var(--text-base);
  }

  /* The contents list is grouped by the movements of a proof. */
  .movements {
    margin-top: 0.5rem;
    columns: 2;
    column-gap: 1.5rem;
  }

  .movement {
    break-inside: avoid;
    padding-bottom: 0.5rem;
  }

  .movement-label {
    display: block;
    font-style: italic;
    color: var(--muted);
  }

  .toc a {
    display: flex;
    align-items: center;
    min-height: 2.25rem;
    color: var(--text);
  }

  .toc a:hover {
    text-decoration: underline;
    text-decoration-color: var(--mark);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  .case-body {
    min-width: 0;
  }

  .case-body > section {
    max-width: 46rem;
    padding-block: clamp(2rem, 5vw, 3rem);
    border-top: 1px solid var(--line-strong);
  }

  /* The picture gallery may run wider than the text measure. */
  .case-body > section.wide {
    max-width: none;
  }

  .gallery {
    display: grid;
    gap: 2rem 1.5rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 48rem) {
    .gallery {
      grid-template-columns: 1fr 1fr;
    }
  }

  .case-body > section:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .case-body h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3.4vw, 2.25rem);
    font-weight: 700;
    line-height: 1.1;
  }

  .case-body h3 {
    margin-top: 2rem;
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.25;
  }

  .case-body p {
    margin-top: 1.125rem;
    color: var(--muted);
  }

  .case-body h2 + p {
    margin-top: 1.25rem;
  }

  #overview p:first-of-type {
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--text);
  }

  .note p {
    margin-top: 0.5rem;
  }

  .case-body .aside {
    padding-left: 1rem;
    border-left: 2px solid var(--mark);
    font-size: var(--text-sm);
  }

  .bullets {
    display: grid;
    gap: 0.625rem;
    margin-top: 1.25rem;
    color: var(--muted);
  }

  .bullets li {
    position: relative;
    padding-left: 1.375rem;
  }

  .bullets li::before {
    content: '';
    position: absolute;
    left: 0.125rem;
    top: 0.62em;
    width: 0.4375rem;
    height: 0.4375rem;
    border: 1px solid var(--text);
  }

  .tech {
    margin-top: 1.5rem;
  }

  .tech th {
    width: 11rem;
  }

  .figure {
    margin-top: 2.25rem;
  }

  .figure-diagram {
    padding: clamp(1.25rem, 4vw, 2.5rem);
  }

  .results {
    margin-top: 1.5rem;
  }

  .results tbody th {
    width: 30%;
  }

  .results .source {
    width: 28%;
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .case-body p.caption {
    margin-top: 0.875rem;
  }

  .qed {
    display: flex;
    justify-content: flex-end;
    max-width: 46rem;
  }

  .qed .tombstone {
    width: 1rem;
    height: 1rem;
  }

  /* Where to go next: the other projects, by what they share with this one. */
  .related {
    display: grid;
    gap: 1.5rem;
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-top: 1.75rem;
    border-top: 2px solid var(--text);
  }

  .related-head h2 {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.2;
  }

  .related-head p {
    max-width: 34rem;
    margin-top: 0.5rem;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .related-list {
    border-top: 1px solid var(--line-strong);
  }

  .related-list li {
    border-bottom: 1px solid var(--line-strong);
  }

  .related-list a {
    display: grid;
    gap: 0.25rem 2rem;
    padding-block: 1rem;
  }

  .related-name {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: 1.25;
  }

  .related-list a:hover .related-name {
    text-decoration: underline;
    text-decoration-color: var(--mark);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .related-result {
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .related-shared {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.125rem 0.875rem;
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .related-count {
    color: var(--text);
  }

  .related-pair {
    display: inline-flex;
    align-items: baseline;
    gap: 0.375rem;
    white-space: nowrap;
  }

  .related-pair .tombstone {
    width: 0.4375rem;
    height: 0.4375rem;
  }

  .related-figure {
    font-size: var(--text-sm);
  }

  .related-figure a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  @media (min-width: 64rem) {
    .related-list a {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }

    .related-result {
      grid-column: 1;
    }

    .related-shared {
      grid-column: 2;
      grid-row: 1 / span 2;
      padding-top: 0.3125rem;
    }
  }

  @media (min-width: 40rem) {
    .case-meta {
      grid-template-columns: 1fr 1fr;
    }

    .case-meta > div:nth-child(2) {
      border-top: 0;
    }

    .case-meta > div:nth-child(even) {
      border-left: 1px solid var(--line-strong);
    }
  }

  @media (min-width: 64rem) {
    .case-meta {
      grid-template-columns: 1.4fr 1.2fr 0.9fr 1.5fr;
    }

    .case-meta > div + div {
      border-top: 0;
      border-left: 1px solid var(--line-strong);
    }
  }

  @media (max-width: 39.99rem) {
    /* On phones each result stacks: measure, result, then its source. */
    .results thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .results tbody tr {
      display: grid;
      padding-block: 0.75rem;
    }

    .results tbody tr + tr {
